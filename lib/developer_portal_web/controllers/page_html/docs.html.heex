<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class={[
      "mx-auto max-w-7xl gap-8",
      length(@versions) > 1 && "grid lg:grid-cols-[260px_1fr]"
    ]}>
      <%= if length(@versions) > 1 do %>
        <aside class="card h-fit border border-base-300 bg-base-100 shadow-lg">
          <div class="card-body">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
              Versions
            </p>
            <div class="menu gap-2 rounded-box bg-base-200/50 p-2">
              <%= for version <- @versions do %>
                <a
                  href={~p"/docs/#{version.id}"}
                  class={[
                    "rounded-btn px-3 py-2 text-sm",
                    version.id == @docs_version.id && "bg-primary text-primary-content"
                  ]}
                >
                  {version.label}
                </a>
              <% end %>
            </div>
          </div>
        </aside>
      <% end %>

      <div class="space-y-8">
        <div class="space-y-4">
          <h1 class="text-4xl font-semibold tracking-tight">{@docs_version.title}</h1>
          <p class="max-w-3xl text-lg leading-8 text-base-content/72">{@docs_version.summary}</p>
          <div class="flex flex-wrap gap-3">
            <a href={~p"/docs/#{@docs_version.id}/api"} class="btn btn-primary">
              API Reference
            </a>
            <a
              href="https://code.carverauto.dev/carverauto/serviceradar-sdk-go"
              class="btn btn-outline"
              target="_blank"
              rel="noreferrer"
            >
              Go SDK Repo
            </a>
            <a
              href="https://code.carverauto.dev/carverauto/serviceradar-sdk-rust"
              class="btn btn-outline"
              target="_blank"
              rel="noreferrer"
            >
              Rust SDK Repo
            </a>
            <a href={~p"/contribute"} class="btn btn-outline">Contribution Guide</a>
          </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          <%= for section <- @docs_version.sections do %>
            <article
              id={"docs-section-#{section.id}"}
              class="group flex min-h-52 flex-col rounded-lg border border-base-300 bg-base-100 p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg"
            >
              <div class="flex flex-1 flex-col gap-4">
                <div class="space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-xl font-semibold tracking-tight">{section.title}</h2>
                    <span class="shrink-0 rounded-full border border-base-300 px-2.5 py-1 text-xs font-medium text-base-content/70">
                      {section.audience}
                    </span>
                  </div>
                  <p class="text-sm leading-6 text-base-content/70">{section.description}</p>
                </div>
                <a
                  href={~p"/docs/#{@docs_version.id}/#{section.id}"}
                  class="mt-auto inline-flex w-fit items-center gap-2 text-sm font-semibold text-primary transition group-hover:translate-x-0.5"
                >
                  Open guide <.icon name="hero-arrow-right" class="h-4 w-4" />
                </a>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
