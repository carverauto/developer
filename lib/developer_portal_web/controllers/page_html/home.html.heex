<Layouts.app flash={@flash}>
  <section class="hero-shell px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-4xl">
      <div class="space-y-6">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-primary">
          WebAssembly plugins, versioned docs, trusted distribution
        </p>
        <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-balance sm:text-6xl">
          Build, publish, and discover ServiceRadar extensions in one place.
        </h1>
        <p class="max-w-2xl text-lg leading-8 text-base-content/72">
          Find the docs you need, browse available plugins, and quickly see which packages are official
          and signed.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={~p"/docs/v2"} class="btn btn-primary btn-wide sm:btn-md">Read docs</a>
          <a href={~p"/plugins"} class="btn btn-outline btn-wide sm:btn-md">Browse plugins</a>
          <a href={~p"/contribute"} class="btn btn-ghost btn-wide sm:btn-md">Submit a plugin</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-8 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">Plugins</p>
          <h2 class="text-2xl font-semibold">Official plugins</h2>
        </div>
        <a href={~p"/plugins"} class="link link-hover text-sm font-medium">View full directory</a>
      </div>

      <div class="grid gap-4 lg:grid-cols-3">
        <%= for plugin <- @featured_plugins do %>
          <article class="card border border-base-300 bg-base-100 shadow-lg">
            <div class="card-body">
              <div class="flex flex-wrap gap-2">
                <span class={[
                  "badge",
                  plugin.type == "official" && "badge-primary",
                  plugin.type == "community" && "badge-secondary"
                ]}>
                  {String.capitalize(plugin.type)}
                </span>
                <span class="badge badge-outline">{plugin.language}</span>
                <span class={[
                  "badge",
                  plugin.signed && "badge-success",
                  !plugin.signed && "badge-warning"
                ]}>
                  {if plugin.signed, do: "Signed", else: "Unsigned"}
                </span>
              </div>
              <h3 class="card-title">{plugin.name}</h3>
              <p class="text-sm text-base-content/70">{plugin.summary}</p>
              <div class="card-actions justify-end">
                <a href={~p"/plugins/#{plugin.slug}"} class="btn btn-sm btn-outline">Details</a>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>
</Layouts.app>
