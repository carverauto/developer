<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-[1280px] space-y-8">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
          Add-on catalog
        </p>
        <h1 class="text-4xl font-semibold tracking-tight text-sr-ink">
          Published, signed native add-ons for the ServiceRadar agent.
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-sr-muted">
          Native add-ons are compiled Go or Rust binaries the agent supervises out-of-process. Every add-on below ships as a signed OCI artifact verified against the agent release trust root.
        </p>
      </div>

      <.form
        for={@form}
        id="addon-filters"
        phx-change="filter"
        class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface"
      >
        <div class="grid gap-4 md:grid-cols-3">
          <.input
            field={@form[:q]}
            type="text"
            label="Search"
            placeholder="name, capability, supervision..."
          />
          <.input
            field={@form[:language]}
            type="select"
            label="Language"
            options={["" | @languages]}
          />
          <.input
            field={@form[:supervision]}
            type="select"
            label="Supervision"
            options={["" | @supervisions]}
          />
        </div>
      </.form>

      <%= if Enum.empty?(@addons) do %>
        <article class="rounded-sr-surface border border-dashed border-sr-line bg-sr-surface p-6 shadow-sr-control">
          <div class="space-y-4">
            <h2 class="text-lg font-semibold text-sr-ink">No add-ons available yet</h2>
            <p class="text-sm text-sr-muted">
              The catalog cache is still warming or no add-ons matched the current filters.
            </p>
          </div>
        </article>
      <% else %>
        <div class="grid gap-4 lg:grid-cols-3">
          <%= for addon <- @addons do %>
            <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
              <div class="space-y-4">
                <div class="flex flex-wrap gap-2">
                  <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                    {addon.language}
                  </span>
                  <%= if addon.supervision do %>
                    <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                      {addon.supervision}
                    </span>
                  <% end %>
                  <span class={[
                    "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
                    addon.signed &&
                      "inline-flex items-center rounded-full border border-sr-success-line bg-sr-success-soft px-2.5 py-0.5 text-xs font-medium text-sr-success",
                    !addon.signed &&
                      "inline-flex items-center rounded-full border border-sr-warning-line bg-sr-warning-soft px-2.5 py-0.5 text-xs font-medium text-sr-warning"
                  ]}>
                    {if addon.signed, do: "Signed", else: "Unsigned"}
                  </span>
                </div>

                <div class="space-y-2">
                  <h2 class="text-lg font-semibold text-sr-ink">{addon.name}</h2>
                  <p class="text-sm text-sr-muted">{addon.summary}</p>
                  <%= if Enum.any?(addon.architectures || []) do %>
                    <p class="text-xs uppercase tracking-[0.18em] text-sr-muted">
                      {Enum.join(addon.architectures, " · ")}
                    </p>
                  <% end %>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm text-sr-muted">Version {addon.version}</span>
                  <a
                    href={~p"/addons/#{addon.slug}"}
                    class="inline-flex min-h-9 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-3.5 py-2 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  >
                    Details
                  </a>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</Layouts.app>
