<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="space-y-4">
        <a
          href={~p"/addons"}
          class="text-sm font-medium text-sr-brand underline-offset-2 hover:underline"
        >
          Back to add-on catalog
        </a>
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-full border border-sr-brand/30 bg-sr-brand/10 px-2.5 py-0.5 text-xs font-medium text-sr-brand">
            Native add-on
          </span>
          <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
            {@addon.language}
          </span>
          <%= if @addon.supervision do %>
            <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
              {@addon.supervision}
            </span>
          <% end %>
          <%= if @addon.delivery do %>
            <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
              {@addon.delivery}
            </span>
          <% end %>
          <span class={[
            "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
            @addon.signed &&
              "inline-flex items-center rounded-full border border-sr-success-line bg-sr-success-soft px-2.5 py-0.5 text-xs font-medium text-sr-success",
            !@addon.signed &&
              "inline-flex items-center rounded-full border border-sr-warning-line bg-sr-warning-soft px-2.5 py-0.5 text-xs font-medium text-sr-warning"
          ]}>
            {if @addon.signed, do: "Signed artifact", else: "Unsigned artifact"}
          </span>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight text-sr-ink">{@addon.name}</h1>
        <p class="max-w-3xl text-lg leading-8 text-sr-muted">{@addon.description}</p>
      </div>

      <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
        <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
          <div class="space-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                Trust signal
              </p>
              <p class="mt-2 text-sm text-sr-muted">
                {if @addon.signed,
                  do:
                    "This add-on ships as a signed OCI artifact. Each per-architecture bundle is signed with ed25519 against the ServiceRadar agent release trust root and verified by the agent before activation.",
                  else:
                    "This add-on does not yet have a signed published artifact, so operators should evaluate it with additional caution."}
              </p>
            </div>

            <%= if @addon.oci_ref do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Signed OCI bundle
                </p>
                <p class="mt-2 text-sm text-sr-muted">
                  Pull the signed bundle from the ServiceRadar registry, then assign it to an agent from the control plane.
                </p>
                <pre class="mt-3 overflow-x-auto rounded-sr-surface border border-sr-line bg-sr-subtle p-3 text-xs"><code>oras pull {@addon.oci_ref}</code></pre>
                <%= if @addon.bundle_digest do %>
                  <p class="mt-2 break-all text-xs text-sr-muted">
                    Bundle digest: <code>{@addon.bundle_digest}</code>
                  </p>
                <% end %>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.architectures || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Signed artifacts
                </p>
                <div class="mt-3 overflow-x-auto">
                  <table class="table table-sm">
                    <thead>
                      <tr>
                        <th>Platform</th>
                        <th>Signature</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for artifact <- @addon.artifacts do %>
                        <tr>
                          <td class="font-medium">{artifact.os}/{artifact.arch}</td>
                          <td>
                            <%= if artifact.signature_digest do %>
                              <span class="inline-flex items-center rounded-full border border-sr-success-line bg-sr-success-soft px-2.5 py-0.5 text-xs font-medium text-sr-success">
                                Signed
                              </span>
                            <% else %>
                              <span class="inline-flex items-center rounded-full border border-sr-warning-line bg-sr-warning-soft px-2.5 py-0.5 text-xs font-medium text-sr-warning">
                                Unsigned
                              </span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.capabilities || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Capabilities
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for capability <- @addon.capabilities do %>
                    <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                      {capability}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.platforms || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Platforms
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for platform <- @addon.platforms do %>
                    <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                      {platform}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </article>

        <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-sr-muted">Version</span>
              <span class="font-medium">{@addon.version}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-sr-muted">Language</span>
              <span class="font-medium">{@addon.language}</span>
            </div>
            <%= if @addon.delivery do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-sr-muted">Delivery</span>
                <span class="font-medium">{@addon.delivery}</span>
              </div>
            <% end %>
            <%= if @addon.supervision do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-sr-muted">Supervision</span>
                <span class="font-medium">{@addon.supervision}</span>
              </div>
            <% end %>
            <div class="mt-4 flex flex-col items-stretch gap-3">
              <a
                href={@addon.docs_path}
                class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-brand bg-sr-brand px-5 py-2.5 text-sm font-semibold text-sr-on-brand shadow-sr-button outline-none transition hover:bg-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
              >
                Reference docs
              </a>
              <%= if @addon.source_url do %>
                <a
                  href={@addon.source_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Source repository
                </a>
              <% end %>
              <%= if @addon.readme_url do %>
                <a
                  href={@addon.readme_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  README
                </a>
              <% end %>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
