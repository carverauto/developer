<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="space-y-4">
        <a href={~p"/addons"} class="link link-hover text-sm font-medium">
          Back to add-on catalog
        </a>
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-primary">Native add-on</span>
          <span class="badge badge-outline">{@addon.language}</span>
          <%= if @addon.supervision do %>
            <span class="badge badge-outline">{@addon.supervision}</span>
          <% end %>
          <%= if @addon.delivery do %>
            <span class="badge badge-outline">{@addon.delivery}</span>
          <% end %>
          <span class={[
            "badge",
            @addon.signed && "badge-success",
            !@addon.signed && "badge-warning"
          ]}>
            {if @addon.signed, do: "Signed artifact", else: "Unsigned artifact"}
          </span>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight">{@addon.name}</h1>
        <p class="max-w-3xl text-lg leading-8 text-base-content/72">{@addon.description}</p>
      </div>

      <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
        <article class="card border border-base-300 bg-base-100 shadow-lg">
          <div class="card-body space-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                Trust signal
              </p>
              <p class="mt-2 text-sm text-base-content/80">
                {if @addon.signed,
                  do:
                    "This add-on ships as a signed OCI artifact. Each per-architecture bundle is signed with ed25519 against the ServiceRadar agent release trust root and verified by the agent before activation.",
                  else:
                    "This add-on does not yet have a signed published artifact, so operators should evaluate it with additional caution."}
              </p>
            </div>

            <%= if @addon.oci_ref do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                  Signed OCI bundle
                </p>
                <p class="mt-2 text-sm text-base-content/80">
                  Pull the signed bundle from the ServiceRadar registry, then assign it to an agent from the control plane.
                </p>
                <pre class="mt-3 overflow-x-auto rounded-box border border-base-300 bg-base-200 p-3 text-xs"><code>oras pull {@addon.oci_ref}</code></pre>
                <%= if @addon.bundle_digest do %>
                  <p class="mt-2 break-all text-xs text-base-content/60">
                    Bundle digest: <code>{@addon.bundle_digest}</code>
                  </p>
                <% end %>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.architectures || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                  Signed artifacts
                </p>
                <div class="mt-3 overflow-x-auto">
                  <table class="table table-sm">
                    <thead>
                      <tr>
                        <th>Platform</th>
                        <th>Signature</th>
                      </tr>
                    </thead>
                    <tbody>
                      <%= for artifact <- @addon.artifacts do %>
                        <tr>
                          <td class="font-medium">{artifact.os}/{artifact.arch}</td>
                          <td>
                            <%= if artifact.signature_digest do %>
                              <span class="badge badge-success badge-sm">Signed</span>
                            <% else %>
                              <span class="badge badge-warning badge-sm">Unsigned</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.capabilities || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                  Capabilities
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for capability <- @addon.capabilities do %>
                    <span class="badge badge-outline">{capability}</span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if Enum.any?(@addon.platforms || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                  Platforms
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for platform <- @addon.platforms do %>
                    <span class="badge badge-outline">{platform}</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-lg">
          <div class="card-body space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-base-content/60">Version</span>
              <span class="font-medium">{@addon.version}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-base-content/60">Language</span>
              <span class="font-medium">{@addon.language}</span>
            </div>
            <%= if @addon.delivery do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-base-content/60">Delivery</span>
                <span class="font-medium">{@addon.delivery}</span>
              </div>
            <% end %>
            <%= if @addon.supervision do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-base-content/60">Supervision</span>
                <span class="font-medium">{@addon.supervision}</span>
              </div>
            <% end %>
            <div class="card-actions mt-4 flex-col items-stretch">
              <a href={@addon.docs_path} class="btn btn-primary">Reference docs</a>
              <%= if @addon.source_url do %>
                <a
                  href={@addon.source_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Source repository
                </a>
              <% end %>
              <%= if @addon.readme_url do %>
                <a
                  href={@addon.readme_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  README
                </a>
              <% end %>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
