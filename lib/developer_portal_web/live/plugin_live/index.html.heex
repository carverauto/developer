<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-[1280px] space-y-8">
      <div class="space-y-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
          Plugin directory
        </p>
        <h1 class="text-4xl font-semibold tracking-tight text-sr-ink">
          Official and community plugins in one searchable registry.
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-sr-muted">
          Filter by keyword, provenance, language, and category. Signature status stays visible so operators can quickly evaluate trust.
        </p>
      </div>

      <.form
        for={@form}
        id="plugin-filters"
        phx-change="filter"
        class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface"
      >
        <div class="grid gap-4 md:grid-cols-4">
          <.input
            field={@form[:q]}
            type="text"
            label="Search"
            placeholder="name, author, category..."
          />
          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={["", "official", "community"]}
          />
          <.input
            field={@form[:language]}
            type="select"
            label="Language"
            options={["" | @languages]}
          />
          <.input
            field={@form[:category]}
            type="select"
            label="Category"
            options={["" | @categories]}
          />
        </div>
      </.form>

      <%= if Enum.empty?(@plugins) do %>
        <article class="rounded-sr-surface border border-dashed border-sr-line bg-sr-surface p-6 shadow-sr-control">
          <div class="space-y-4">
            <h2 class="text-lg font-semibold text-sr-ink">No plugins available yet</h2>
            <p class="text-sm text-sr-muted">
              The registry cache is still warming or no plugins matched the current filters.
            </p>
          </div>
        </article>
      <% else %>
        <div class="grid gap-4 lg:grid-cols-3">
          <%= for plugin <- @plugins do %>
            <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
              <div class="space-y-4">
                <div class="flex flex-wrap gap-2">
                  <span class={[
                    "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
                    plugin.type == "official" &&
                      "inline-flex items-center rounded-full border border-sr-brand/30 bg-sr-brand/10 px-2.5 py-0.5 text-xs font-medium text-sr-brand",
                    plugin.type == "community" &&
                      "inline-flex items-center rounded-full border border-sr-info-line bg-sr-info-soft px-2.5 py-0.5 text-xs font-medium text-sr-info"
                  ]}>
                    {String.capitalize(plugin.type)}
                  </span>
                  <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                    {plugin.language}
                  </span>
                  <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                    {plugin.category}
                  </span>
                  <span class={[
                    "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
                    plugin.signed &&
                      "inline-flex items-center rounded-full border border-sr-success-line bg-sr-success-soft px-2.5 py-0.5 text-xs font-medium text-sr-success",
                    !plugin.signed &&
                      "inline-flex items-center rounded-full border border-sr-warning-line bg-sr-warning-soft px-2.5 py-0.5 text-xs font-medium text-sr-warning"
                  ]}>
                    {if plugin.signed, do: "Signed", else: "Unsigned"}
                  </span>
                </div>

                <div class="space-y-2">
                  <h2 class="text-lg font-semibold text-sr-ink">{plugin.name}</h2>
                  <p class="text-sm text-sr-muted">{plugin.summary}</p>
                  <p class="text-xs uppercase tracking-[0.2em] text-sr-muted">
                    by {plugin.author}
                  </p>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm text-sr-muted">Version {plugin.version}</span>
                  <a
                    href={~p"/plugins/#{plugin.slug}"}
                    class="inline-flex min-h-9 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-3.5 py-2 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  >
                    Details
                  </a>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</Layouts.app>
