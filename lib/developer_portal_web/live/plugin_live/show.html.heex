<Layouts.app flash={@flash}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="space-y-4">
        <a
          href={~p"/plugins"}
          class="text-sm font-medium text-sr-brand underline-offset-2 hover:underline"
        >
          Back to plugin directory
        </a>
        <div class="flex flex-wrap gap-2">
          <span class={[
            "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
            @plugin.type == "official" &&
              "inline-flex items-center rounded-full border border-sr-brand/30 bg-sr-brand/10 px-2.5 py-0.5 text-xs font-medium text-sr-brand",
            @plugin.type == "community" &&
              "inline-flex items-center rounded-full border border-sr-info-line bg-sr-info-soft px-2.5 py-0.5 text-xs font-medium text-sr-info"
          ]}>
            {String.capitalize(@plugin.type)}
          </span>
          <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
            {@plugin.language}
          </span>
          <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
            {@plugin.category}
          </span>
          <span class={[
            "inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted",
            @plugin.signed &&
              "inline-flex items-center rounded-full border border-sr-success-line bg-sr-success-soft px-2.5 py-0.5 text-xs font-medium text-sr-success",
            !@plugin.signed &&
              "inline-flex items-center rounded-full border border-sr-warning-line bg-sr-warning-soft px-2.5 py-0.5 text-xs font-medium text-sr-warning"
          ]}>
            {if @plugin.signed, do: "Signed artifact", else: "Unsigned artifact"}
          </span>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight text-sr-ink">{@plugin.name}</h1>
        <p class="max-w-3xl text-lg leading-8 text-sr-muted">{@plugin.description}</p>
      </div>

      <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
        <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
          <div class="space-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                Installation
              </p>
              <p class="mt-2 text-sm text-sr-muted">{@plugin.installation}</p>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                Trust signal
              </p>
              <p class="mt-2 text-sm text-sr-muted">
                {if @plugin.signed,
                  do:
                    "This plugin ships as a signed OCI artifact, verified against the ServiceRadar agent release trust root before it is loaded.",
                  else:
                    "This plugin does not yet have a signed published artifact, so operators should evaluate it with additional caution."}
              </p>
            </div>

            <%= if @plugin.oci_ref do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Signed OCI bundle
                </p>
                <p class="mt-2 text-sm text-sr-muted">
                  Pull the signed bundle from the ServiceRadar registry, then assign it to an agent from the control plane.
                </p>
                <pre class="mt-3 overflow-x-auto rounded-sr-surface border border-sr-line bg-sr-subtle p-3 text-xs"><code>oras pull {@plugin.oci_ref}</code></pre>
                <%= if @plugin.bundle_digest do %>
                  <p class="mt-2 break-all text-xs text-sr-muted">
                    Bundle digest: <code>{@plugin.bundle_digest}</code>
                  </p>
                <% end %>
              </div>
            <% end %>

            <%= if Enum.any?(@plugin.capabilities || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sr-brand">
                  Capabilities
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for capability <- @plugin.capabilities do %>
                    <span class="inline-flex items-center rounded-full border border-sr-line bg-sr-subtle px-2.5 py-0.5 text-xs font-medium text-sr-muted">
                      {capability}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </article>

        <article class="rounded-sr-surface border border-sr-line bg-sr-surface p-6 shadow-sr-surface">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-sr-muted">Author</span>
              <span class="font-medium">{@plugin.author}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-sr-muted">Version</span>
              <span class="font-medium">{@plugin.version}</span>
            </div>
            <%= if @plugin.sample_kind do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-sr-muted">Package kind</span>
                <span class="font-medium">{String.capitalize(@plugin.sample_kind)}</span>
              </div>
            <% end %>
            <%= if @plugin.runtime do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-sr-muted">Runtime</span>
                <span class="font-medium">{@plugin.runtime}</span>
              </div>
            <% end %>
            <%= if @plugin.entrypoint do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-sr-muted">Entrypoint</span>
                <code class="font-medium text-xs">{@plugin.entrypoint}</code>
              </div>
            <% end %>
            <%= if @plugin.outputs do %>
              <div class="space-y-1">
                <span class="text-sm text-sr-muted">Outputs</span>
                <code class="block text-xs">{@plugin.outputs}</code>
              </div>
            <% end %>
            <div class="mt-4 flex flex-col items-stretch gap-3">
              <%= if @plugin.source_url do %>
                <a
                  href={@plugin.source_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Source repository
                </a>
              <% end %>
              <%= if @plugin.readme_url do %>
                <a
                  href={@plugin.readme_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  README
                </a>
              <% end %>
              <%= if @plugin.manifest_url do %>
                <a
                  href={@plugin.manifest_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Manifest
                </a>
              <% end %>
              <%= if @plugin.config_schema_url do %>
                <a
                  href={@plugin.config_schema_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Config schema
                </a>
              <% end %>
              <%= if @plugin.wasm_url do %>
                <a
                  href={@plugin.wasm_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-brand bg-sr-brand px-5 py-2.5 text-sm font-semibold text-sr-on-brand shadow-sr-button outline-none transition hover:bg-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  WASM package
                </a>
              <% end %>
              <%= if is_nil(@plugin.wasm_url) and is_nil(@plugin.oci_ref) do %>
                <button
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-brand bg-sr-brand px-5 py-2.5 text-sm font-semibold text-sr-on-brand shadow-sr-button outline-none transition hover:bg-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  disabled
                >
                  Package coming soon
                </button>
              <% end %>
              <%= if @plugin.artifact_url do %>
                <a
                  href={@plugin.artifact_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Checksum
                </a>
              <% end %>
              <%= if @plugin.signature_url do %>
                <a
                  href={@plugin.signature_url}
                  class="inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-sr-control border border-sr-line-strong bg-sr-control px-5 py-2.5 text-sm font-semibold text-sr-ink shadow-sr-control outline-none transition hover:border-sr-brand hover:text-sr-brand-strong focus-visible:ring-2 focus-visible:ring-sr-focus"
                  target="_blank"
                  rel="noreferrer"
                >
                  Signature
                </a>
              <% end %>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
