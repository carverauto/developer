<Layouts.app flash={@flash} current_user={@current_user} auth_enabled={@auth_enabled}>
  <section class="px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl space-y-8">
      <div class="space-y-4">
        <a href={~p"/plugins"} class="link link-hover text-sm font-medium">
          Back to plugin directory
        </a>
        <div class="flex flex-wrap gap-2">
          <span class={[
            "badge",
            @plugin.type == "official" && "badge-primary",
            @plugin.type == "community" && "badge-secondary"
          ]}>
            {String.capitalize(@plugin.type)}
          </span>
          <span class="badge badge-outline">{@plugin.language}</span>
          <span class="badge badge-outline">{@plugin.category}</span>
          <span class={[
            "badge",
            @plugin.signed && "badge-success",
            !@plugin.signed && "badge-warning"
          ]}>
            {if @plugin.signed, do: "Signed artifact", else: "Unsigned artifact"}
          </span>
        </div>
        <h1 class="text-4xl font-semibold tracking-tight">{@plugin.name}</h1>
        <p class="max-w-3xl text-lg leading-8 text-base-content/72">{@plugin.description}</p>
      </div>

      <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
        <article class="card border border-base-300 bg-base-100 shadow-lg">
          <div class="card-body space-y-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                Installation
              </p>
              <p class="mt-2 text-sm text-base-content/80">{@plugin.installation}</p>
            </div>

            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                Trust signal
              </p>
              <p class="mt-2 text-sm text-base-content/80">
                {if @plugin.signed,
                  do:
                    "This plugin is presented as signed, so the UI can highlight it as a trusted release candidate pending verification policy.",
                  else:
                    "This plugin is currently surfaced as unsigned so operators can evaluate it with additional caution."}
              </p>
            </div>

            <%= if Enum.any?(@plugin.capabilities || []) do %>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.24em] text-secondary">
                  Capabilities
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <%= for capability <- @plugin.capabilities do %>
                    <span class="badge badge-outline">{capability}</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </article>

        <article class="card border border-base-300 bg-base-100 shadow-lg">
          <div class="card-body space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-sm text-base-content/60">Author</span>
              <span class="font-medium">{@plugin.author}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-base-content/60">Version</span>
              <span class="font-medium">{@plugin.version}</span>
            </div>
            <%= if @plugin.sample_kind do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-base-content/60">Package kind</span>
                <span class="font-medium">{String.capitalize(@plugin.sample_kind)}</span>
              </div>
            <% end %>
            <%= if @plugin.runtime do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-base-content/60">Runtime</span>
                <span class="font-medium">{@plugin.runtime}</span>
              </div>
            <% end %>
            <%= if @plugin.entrypoint do %>
              <div class="flex items-center justify-between">
                <span class="text-sm text-base-content/60">Entrypoint</span>
                <code class="font-medium text-xs">{@plugin.entrypoint}</code>
              </div>
            <% end %>
            <%= if @plugin.outputs do %>
              <div class="space-y-1">
                <span class="text-sm text-base-content/60">Outputs</span>
                <code class="block text-xs">{@plugin.outputs}</code>
              </div>
            <% end %>
            <div class="card-actions mt-4 flex-col items-stretch">
              <%= if @plugin.source_url do %>
                <a
                  href={@plugin.source_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Source repository
                </a>
              <% end %>
              <%= if @plugin.readme_url do %>
                <a
                  href={@plugin.readme_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  README
                </a>
              <% end %>
              <%= if @plugin.manifest_url do %>
                <a
                  href={@plugin.manifest_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Manifest
                </a>
              <% end %>
              <%= if @plugin.config_schema_url do %>
                <a
                  href={@plugin.config_schema_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Config schema
                </a>
              <% end %>
              <%= if @plugin.wasm_url do %>
                <a
                  href={@plugin.wasm_url}
                  class="btn btn-primary"
                  target="_blank"
                  rel="noreferrer"
                >
                  WASM package
                </a>
              <% else %>
                <button class="btn btn-primary" disabled>WASM package coming soon</button>
              <% end %>
              <%= if @plugin.artifact_url do %>
                <a
                  href={@plugin.artifact_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Checksum
                </a>
              <% end %>
              <%= if @plugin.signature_url do %>
                <a
                  href={@plugin.signature_url}
                  class="btn btn-outline"
                  target="_blank"
                  rel="noreferrer"
                >
                  Signature
                </a>
              <% end %>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
